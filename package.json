{
  "name": "watchlog",
  "version": "0.1.0",
  "description": "A private, local-first movie and television journal",
  "author": "WatchLog contributors",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "format": "prettier --write src electron shared scripts tests *.json vite.config.ts index.html",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/icons.mjs && tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "electron .",
    "test": "node scripts/test.mjs",
    "test:desktop": "node tests/desktop.mjs",
    "package:win": "npm run build && electron-builder --win nsis --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg --publish never",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.27.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "app.watchlog.desktop",
    "productName": "WatchLog",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.entertainment",
      "hardenedRuntime": true,
      "icon": "build/icon.png"
    }
  }
}
